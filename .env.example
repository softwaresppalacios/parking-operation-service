DB_URL=jdbc:postgresql://localhost:5432/parking_operation_service_db?currentSchema=parking_operation_service
DB_USERNAME=postgres
DB_PASSWORD=root

# WhatsApp Cloud API (plantilla del ticket de entrada). El token va en .env, que no se versiona.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=ticket_sp_parqueaderos
WHATSAPP_TEMPLATE_LANGUAGE=es_CO

# Poner en false para pausar el envio (por ejemplo mientras Meta aprueba la plantilla).
WHATSAPP_ENABLED=true
